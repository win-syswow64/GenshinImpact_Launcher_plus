<UserControl x:Class="GenShin_Launcher_Plus.Views.ScreenshotsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Style="{StaticResource SubPageHeader}" Height="64">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Width="36" Height="36"
                        Content="&#xE72B;" Foreground="#B0FFFFFF"
                        Command="{Binding BackCommand}" ToolTip="{Binding BackToolTip}"
                        VerticalAlignment="Center"/>
                <Border Width="36" Height="36" Background="#24FFFFFF" CornerRadius="10" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextFillBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1">
            <!-- Loading indicator -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading}">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Style="{DynamicResource AccentProgressBar}"/>
                <TextBlock Text="{Binding LoadingText}" Foreground="#80FFFFFF"
                           FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty}">
                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}"
                           FontSize="48" Foreground="#40FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyText}" Foreground="#80FFFFFF"
                           FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- Timeline image list -->
            <ListBox x:Name="ImageListBox"
                     ItemsSource="{Binding Groups}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.CacheLength="5"
                     VirtualizingPanel.CacheLengthUnit="Item"
                     SelectionMode="Extended"
                     Margin="24,18,24,22" Padding="16" Background="#4018222F" BorderBrush="#2BFFFFFF" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <!-- Day header -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DateHeader}"
                                               FontSize="18" FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="{Binding CountText}"
                                               FontSize="13" Foreground="#60FFFFFF"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <!-- Image grid for this day -->
                            <ItemsControl ItemsSource="{Binding Items}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="180" Height="120" Margin="0,0,6,6"
                                                CornerRadius="6" ClipToBounds="True"
                                                Background="#1AFFFFFF"
                                                Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <EventSetter Event="MouseLeftButtonDown" Handler="Thumbnail_Click"/>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <!-- Time overlay -->
                                                <Border VerticalAlignment="Bottom"
                                                        Background="#A0000000" Padding="6,3">
                                                    <TextBlock Text="{Binding SaveTime, StringFormat='HH:mm'}"
                                                               FontSize="11" Foreground="#B0FFFFFF"/>
                                                </Border>
                                                <!-- Placeholder -->
                                                <TextBlock Text="&#xE8B9;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="28" Foreground="#30FFFFFF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding PlaceholderVisible}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Fullscreen image overlay -->
            <Border x:Name="ImageOverlay" Background="#E0000000"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    MouseLeftButtonDown="ImageOverlay_Click"
                    PreviewKeyDown="ImageOverlay_KeyDown">
                <Grid>
                    <Image x:Name="OverlayImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="{Binding ActualWidth, ElementName=ImageOverlay}"
                           MaxHeight="{Binding ActualHeight, ElementName=ImageOverlay}"
                           Margin="40"/>
                    <!-- Close hint -->
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}"
                               FontSize="20" Foreground="#80FFFFFF"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,12,16,0" IsHitTestVisible="False"/>
                    <!-- File info -->
                    <StackPanel x:Name="OverlayInfo" VerticalAlignment="Bottom"
                                HorizontalAlignment="Left" Margin="16,0,0,16"
                                IsHitTestVisible="False">
                        <TextBlock x:Name="OverlayFileName"
                                   FontSize="13" Foreground="#B0FFFFFF"/>
                        <TextBlock x:Name="OverlayFileDate"
                                   FontSize="12" Foreground="#80FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
