<UserControl x:Class="GenShin_Launcher_Plus.Views.LanguagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Border Style="{StaticResource CardBorder}" Width="340" Padding="24"
            VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="{Binding languages.LanguageSetTitle}"
                       Style="{StaticResource SubtitleText}" Margin="0,0,0,20"/>
            <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding langlist}"
                      DisplayMemberPath="LangName" SelectedValue="{Binding SwitchLang, Mode=OneWayToSource}"
                      SelectedValuePath="LangFileName" SelectedIndex="{Binding LangIndex, Mode=OneWay}"
                      Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding languages.Cancel}" Style="{StaticResource SecondaryButton}"
                        Click="RemoveThisPage" Margin="0,0,8,0"/>
                <Button Content="{Binding languages.SaveBtn}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveLangSetCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
