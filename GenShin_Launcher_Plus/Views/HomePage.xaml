<UserControl x:Class="GenShin_Launcher_Plus.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid>
        <!-- Info Cards -->
        <StackPanel Margin="32,32,32,0" VerticalAlignment="Top">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="#20FFFFFF" Margin="0,0,12,0">
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}"
                                   FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding languages.AccountLabel}" Foreground="#80FFFFFF" FontSize="12"/>
                        <TextBlock Text="{Binding DataContext.SwitchUser, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="#20FFFFFF" Margin="0,0,12,0">
                        <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}"
                                   FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding languages.ClientLabel}" Foreground="#80FFFFFF" FontSize="12"/>
                        <TextBlock Text="{Binding DataContext.SwitchPort, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Bottom: Launch + Settings buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="0,0,32,32">
            <!-- Launch -->
            <Button Content="{Binding languages.RunGameBtn}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding RunGameCommand}"
                    Height="52" Width="220"
                    FontSize="18" FontWeight="SemiBold"/>
            <!-- Settings -->
            <Button Style="{StaticResource SecondaryButton}" Height="52" Width="52"
                    FontSize="18" FontFamily="{StaticResource IconFont}"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip="{Binding languages.GameSettingsBtn}"
                    Content="&#xE713;"
                    Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>