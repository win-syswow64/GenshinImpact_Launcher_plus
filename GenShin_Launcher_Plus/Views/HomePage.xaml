<UserControl x:Class="GenShin_Launcher_Plus.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!-- The dashboard mirrors Starward's launcher surface: the background remains the hero,
         while actions and information stay inside a readable left-side safe area. -->
    <Grid Margin="36,28,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="HOYOPLAY LIBRARY" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding DataContext.CurrentGameDisplayName, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                <Border Background="#B526303E" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="11,4">
                    <TextBlock Text="{Binding DataContext.CurrentServerDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#ECFFFFFF" FontSize="11"/>
                </Border>
                <Border Background="#B526303E" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="12" Padding="11,4" Margin="8,0,0,0">
                    <TextBlock Text="{Binding DataContext.VersionStatusText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#CFFFFFFF" FontSize="11"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <Border Grid.RowSpan="3" Width="380" Height="310" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="#B0101824" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <!-- The image layer owns the full fixed banner row; the transparent button only handles its click. -->
                <Grid Grid.Row="0">
                    <Border CornerRadius="16,16,0,0">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding DataContext.CurrentGameBanner.ImageUrl, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="16,16,0,0">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.45"/><GradientStop Color="#B0101722" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                            Command="{Binding DataContext.OpenGameBannerCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="打开官方活动页面"/>
                    <TextBlock Text="游戏资讯" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="16,12" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding DataContext.GameBannerPosition, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#DFFFFFFF" FontSize="11" Margin="12" VerticalAlignment="Bottom" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                </Grid>
                <Button Grid.Row="0" Style="{StaticResource IconButton}" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                        Command="{Binding DataContext.PreviousGameBannerCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="&#xE72B;" ToolTip="上一张"
                        Visibility="{Binding DataContext.HasMultipleBanners, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Row="0" Style="{StaticResource IconButton}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Command="{Binding DataContext.NextGameBannerCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="&#xE72A;" ToolTip="下一张"
                        Visibility="{Binding DataContext.HasMultipleBanners, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                <!-- Dark translucent glass keeps the text readable while retaining the hero artwork behind it. -->
                <Border Grid.Row="1" Margin="10,8,10,10" Background="#78131D2A" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="9">
                    <Grid Margin="12,8,12,7">
                        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Padding="11,4" Margin="0,0,6,0" Command="{Binding DataContext.SelectGameNewsCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="活动" Content="活动">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsActivityNewsSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="#FF101721"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Grid.Column="1" Padding="11,4" Margin="0,0,6,0" Command="{Binding DataContext.SelectGameNewsCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="公告" Content="公告">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsAnnouncementNewsSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="#FF101721"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Grid.Column="2" Padding="11,4" Command="{Binding DataContext.SelectGameNewsCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="资讯" Content="资讯">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsInformationNewsSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="#FF101721"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <TextBlock Grid.Column="3" Text="HoYoPlay 官方" Foreground="#8FFFFFFF" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DataContext.DisplayedGameNews, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Padding="0,5" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.OpenGameNewsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Foreground="#F5FFFFFF" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Date}" Foreground="#CFFFFFFF" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="12"
                                Command="{Binding DataContext.RefreshGameNewsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.ShowNewsStatus, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" Foreground="#AFFFFFFF" FontSize="17" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DataContext.NewsStatusText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#CFFFFFFF" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Border Height="48" Width="190" Background="#C83A4656" BorderBrush="#2CFFFFFF" BorderThickness="1" CornerRadius="24" Padding="17,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" Foreground="#DFFFFFFF" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding DataContext.ActiveAccountDisplay, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <Button Style="{StaticResource SecondaryButton}" Width="48" Height="48" Padding="0" Margin="8,0,0,0"
                        Command="{Binding DataContext.NavigateUsersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="账号管理" Content="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="17"/>
                <Button Style="{StaticResource SecondaryButton}" Width="48" Height="48" Padding="0" Margin="8,0,0,0"
                        Command="{Binding DataContext.VerifyGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        IsEnabled="{Binding DataContext.CanVerifyGame, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="校验游戏资源" Content="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="17"/>
                <Button Style="{StaticResource SecondaryButton}" Width="48" Height="48" Padding="0" Margin="8,0,0,0"
                        Command="{Binding DataContext.RepairGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        IsEnabled="{Binding DataContext.CanRepairGame, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="修复游戏资源" Content="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="17"/>
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Right">
                <Border Background="#C226303E" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="16" Padding="14,10" Margin="0,0,0,8"
                        Visibility="{Binding DataContext.ShowProgressPanel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <StackPanel Width="410">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DataContext.InstallStatusTitle, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding DataContext.InstallService.ProgressText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource AccentProgressBar}" Value="{Binding DataContext.InstallService.ProgressPercent, RelativeSource={RelativeSource AncestorType=Window}}" Maximum="100" Height="4" Margin="0,8,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DataContext.InstallDetailText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#CFFFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0"
                                    Command="{Binding DataContext.ToggleInstallPauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    IsEnabled="{Binding DataContext.CanToggleInstallPause, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="{Binding DataContext.InstallControlText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Width="118" Height="56" Padding="14,0" Margin="0,0,9,0"
                            Command="{Binding DataContext.PreDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding DataContext.ShowPreDownloadButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                            Content="预下载" FontSize="15" FontWeight="SemiBold" ToolTip="提前下载下一版本资源"/>
                    <Button Style="{StaticResource PrimaryButton}" Width="188" Height="56" Margin="0"
                            Command="{Binding DataContext.RunGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            IsEnabled="{Binding DataContext.ActionButtonEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="{Binding DataContext.ActionButtonText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="18" FontWeight="SemiBold"/>
                    <Button Style="{StaticResource SecondaryButton}" Width="56" Height="56" Padding="0" Margin="9,0,0,0"
                            Command="{Binding DataContext.OpenGameSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding languages.GameSettingsBtn}" Content="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="19"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
