<UserControl x:Class="GenShin_Launcher_Plus.Views.SettingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <!-- Top bar -->
        <Grid Height="44" VerticalAlignment="Top" Background="#282828">
            <StackPanel Orientation="Horizontal" Margin="12,0">
                <Button Style="{StaticResource IconButton}" Width="32" Height="32"
                        Content="&#xE72B;" Foreground="#B0FFFFFF"
                        Command="{Binding ThisPageRemoveCommand}" ToolTip="{Binding languages.BackToolTip}"
                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                <!-- Game mode tabs -->
                <RadioButton Style="{StaticResource NavButton}" IsChecked="True"
                             Command="{Binding SwitchGameSettingsCommand}" GroupName="GameTab"
                             Visibility="{Binding GameSettingsVisible}">
                    <TextBlock Text="{Binding languages.GameSettingsTab}" FontSize="13"/>
                </RadioButton>

                <RadioButton Style="{StaticResource NavButton}"
                             Command="{Binding SwitchAccountCommand}" GroupName="GameTab"
                             Visibility="{Binding GameSettingsVisible}">
                    <TextBlock Text="{Binding languages.AccountManageTab}" FontSize="13"/>
                </RadioButton>
                <!-- Program mode tabs -->
                <RadioButton Style="{StaticResource NavButton}" IsChecked="True"
                             Command="{Binding SwitchThemeSettingsCommand}" GroupName="ProgramTab"
                             Visibility="{Binding ProgramSettingsVisible}">
                    <TextBlock Text="{Binding languages.ThemeSettingsTab}" FontSize="13"/>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}"
                             Command="{Binding SwitchLanguageSettingsCommand}" GroupName="ProgramTab"
                             Visibility="{Binding ProgramSettingsVisible}">
                    <TextBlock Text="{Binding languages.LanguageSettingsTab}" FontSize="13"/>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}"
                             Command="{Binding SwitchFunctionSettingsCommand}" GroupName="ProgramTab"
                             Visibility="{Binding ProgramSettingsVisible}">
                    <TextBlock Text="{Binding languages.FunctionSettingsTab}" FontSize="13"/>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}"
                             Command="{Binding SwitchProgramSettingsTabCommand}" GroupName="ProgramTab"
                             Visibility="{Binding ProgramSettingsVisible}">
                    <TextBlock Text="{Binding languages.ProgramSettingsTab}" FontSize="13"/>
                </RadioButton>
                <Button Content="{Binding languages.SaveBtn}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveSettingsCommand}"
                        Margin="16,6,0,6" Padding="20,0" Height="32"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Tab Content -->
        <Grid Margin="0,44,0,0" IsEnabled="{Binding IsPageEnabled}">
            <TabControl SelectedIndex="{Binding FlipViewSelectedIndex}"
                        BorderThickness="0" Background="Transparent" Padding="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Tab 0: Game Settings -->
                <TabItem>
                    <TabItem.Template><ControlTemplate TargetType="TabItem"><ContentPresenter/></ControlTemplate></TabItem.Template>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
                        <StackPanel MaxWidth="600">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="{Binding languages.CustomResolutionHeader}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Width}" Style="{StaticResource InputTextBox}"/>
                                <TextBlock Grid.Column="1" Text=" x " Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Grid.Column="2" Text="{Binding Height}" Style="{StaticResource InputTextBox}"/>
                                <Button Grid.Column="3" Content="&#xE710;" Style="{StaticResource IconButton}" Width="32" Height="32" Command="{Binding SaveDisplaySizeCommand}" ToolTip="{Binding languages.AddPresetToolTip}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="{Binding languages.PresetResolutionHeader}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource DarkComboBox}" DisplayMemberPath="SizeName" SelectedIndex="{Binding DisplaySizeIndex}" ItemsSource="{Binding DisplaySizeLists}" SelectedValue="{Binding SwitchSize, Mode=OneWayToSource}"/>
                                <Button Grid.Column="1" Content="&#xE74D;" Style="{StaticResource IconButton}" Width="32" Height="32" Command="{Binding RemoveDisplaySizeCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="{Binding languages.WindowModeHeader}"/>
                            <ComboBox Style="{StaticResource DarkComboBox}" DisplayMemberPath="GameWindowMode" SelectedIndex="{Binding FullSize}" ItemsSource="{Binding GameWindowModeList}" Margin="0,0,0,12"/>
                            <CheckBox Content="{Binding languages.BorderlessCkB}" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsPopup}" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="{Binding languages.GameDirectoryHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource InputTextBox}" Text="{Binding GamePath}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="&#xE721;" Style="{StaticResource IconButton}" Width="32" Height="32" Command="{Binding AutoSearchGameCommand}" ToolTip="{Binding languages.AutoSearchToolTip}" Margin="8,0,0,0"/>
                                <Button Grid.Column="2" Content="..." Style="{StaticResource SecondaryButton}" Width="40" Command="{Binding ChooseGamePathCommand}" Margin="8,0,0,0"/>
                            </Grid>

                            <!-- Audio Language Packs -->
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="音频语言包" Margin="0,16,0,0"/>
                            <TextBlock Text="{Binding AudioPackDisplayText}" Foreground="#80FFFFFF" FontSize="12" Margin="0,0,0,8"/>
                            <StackPanel IsEnabled="{Binding AudioPackPanelEnabled}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Chinese (zh-cn)" Foreground="#C0FFFFFF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="安装" Style="{StaticResource SecondaryButton}" Width="60" Height="28" FontSize="12"
                                            Command="{Binding InstallAudioPackCommand}" CommandParameter="zh-cn"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="English (en-us)" Foreground="#C0FFFFFF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="安装" Style="{StaticResource SecondaryButton}" Width="60" Height="28" FontSize="12"
                                            Command="{Binding InstallAudioPackCommand}" CommandParameter="en-us"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Japanese (ja-jp)" Foreground="#C0FFFFFF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="安装" Style="{StaticResource SecondaryButton}" Width="60" Height="28" FontSize="12"
                                            Command="{Binding InstallAudioPackCommand}" CommandParameter="ja-jp"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Korean (ko-kr)" Foreground="#C0FFFFFF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="安装" Style="{StaticResource SecondaryButton}" Width="60" Height="28" FontSize="12"
                                            Command="{Binding InstallAudioPackCommand}" CommandParameter="ko-kr"/>
                                </Grid>
                            </StackPanel>
                            <!-- Audio download progress -->
                            <Border Visibility="{Binding IsAudioDownloading, Converter={StaticResource BoolToVis}}" Background="#20FFFFFF" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding AudioInstallService.StatusText}" Foreground="#B0FFFFFF" FontSize="12"/>
                                    <ProgressBar Value="{Binding AudioInstallService.ProgressPercent}" Maximum="100" Height="4" Margin="0,4,0,0"
                                                 Foreground="{DynamicResource AccentBrush}" Background="#20FFFFFF"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding AudioPackStatusText}" Foreground="#80FFFFFF" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 1: Account Management -->
                <TabItem>
                    <TabItem.Template><ControlTemplate TargetType="TabItem"><ContentPresenter/></ControlTemplate></TabItem.Template>
                    <Grid Margin="24,16">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                            <GroupBox Header="{Binding languages.AccountListHeader}" Style="{StaticResource DarkGroupBox}">
                                <ListBox Style="{StaticResource DarkListBox}" ItemContainerStyle="{StaticResource DarkListBoxItem}" DisplayMemberPath="UserName" ItemsSource="{Binding UserLists}" SelectedValue="{Binding SwitchUser, Mode=OneWayToSource}"/>
                            </GroupBox>
                        </Border>
                        <Button Grid.Row="1" Content="{Binding languages.DelUserBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteUserCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    </Grid>
                </TabItem>

                <!-- Tab 3: Theme Settings -->
                <TabItem>
                    <TabItem.Template><ControlTemplate TargetType="TabItem"><ContentPresenter/></ControlTemplate></TabItem.Template>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
                        <StackPanel MaxWidth="600">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="{Binding languages.ThemeColorHeader}"/>
                            <WrapPanel Margin="0,0,0,20">
                                <Border Width="28" Height="28" CornerRadius="14" Background="#FF69B4"
                                        Cursor="Hand" Margin="0,0,8,8" Tag="#FF69B4"
                                        MouseLeftButtonDown="AccentColor_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccentColorIndex}" Value="0">
                                                    <Setter Property="BorderBrush" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#4B7BEC"
                                        Cursor="Hand" Margin="0,0,8,8" Tag="#4B7BEC"
                                        MouseLeftButtonDown="AccentColor_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccentColorIndex}" Value="1">
                                                    <Setter Property="BorderBrush" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#A855F7"
                                        Cursor="Hand" Margin="0,0,8,8" Tag="#A855F7"
                                        MouseLeftButtonDown="AccentColor_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccentColorIndex}" Value="2">
                                                    <Setter Property="BorderBrush" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#22C55E"
                                        Cursor="Hand" Margin="0,0,8,8" Tag="#22C55E"
                                        MouseLeftButtonDown="AccentColor_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccentColorIndex}" Value="3">
                                                    <Setter Property="BorderBrush" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#F59E0B"
                                        Cursor="Hand" Margin="0,0,8,8" Tag="#F59E0B"
                                        MouseLeftButtonDown="AccentColor_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccentColorIndex}" Value="4">
                                                    <Setter Property="BorderBrush" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#EF4444"
                                        Cursor="Hand" Margin="0,0,8,8" Tag="#EF4444"
                                        MouseLeftButtonDown="AccentColor_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccentColorIndex}" Value="5">
                                                    <Setter Property="BorderBrush" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#06B6D4"
                                        Cursor="Hand" Margin="0,0,8,8" Tag="#06B6D4"
                                        MouseLeftButtonDown="AccentColor_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccentColorIndex}" Value="6">
                                                    <Setter Property="BorderBrush" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="28" Height="28" CornerRadius="14" Background="#F472B6"
                                        Cursor="Hand" Margin="0,0,8,8" Tag="#F472B6"
                                        MouseLeftButtonDown="AccentColor_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccentColorIndex}" Value="7">
                                                    <Setter Property="BorderBrush" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </WrapPanel>
                            <!-- Background Settings -->
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="{Binding languages.BackgroundSettingsHeader}"/>

                            <!-- API Background Browser -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding languages.CustomBackgroundHeader}" Foreground="#80FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="&#xE72C;" Style="{StaticResource IconButton}" Width="32" Height="32"
                                        Command="{Binding RefreshBackgroundsCommand}" ToolTip="Refresh"/>
                            </Grid>

                            <!-- Background thumbnails -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Margin="0,0,0,16" Height="98">
                                <ItemsControl ItemsSource="{Binding BackgroundItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="160" Height="90" CornerRadius="6" Cursor="Hand"
                                                    Margin="0,0,8,0" BorderThickness="2"
                                                    BorderBrush="#40FFFFFF"
                                                    MouseLeftButtonDown="BackgroundThumb_Click">
                                                <Grid>
                                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                    <Border Background="#80000000" CornerRadius="4"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Padding="6,2" Margin="4"
                                                            Visibility="{Binding VideoIndicatorVisible}">
                                                        <TextBlock Text="Video" FontSize="10" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Custom file selection -->
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="{Binding languages.CustomBackgroundHeader}"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource InputTextBox}" Text="{Binding CustomBackgroundPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="{Binding languages.ChooseImageBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseCustomBackgroundCommand}" Margin="8,0,0,0"/>
                            </Grid>
                            <Button Content="{Binding languages.SaveTodayBgBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding SaveBackgroundCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 4: Language Settings -->
                <TabItem>
                    <TabItem.Template><ControlTemplate TargetType="TabItem"><ContentPresenter/></ControlTemplate></TabItem.Template>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24"><StackPanel MaxWidth="600">
                        <TextBlock Text="{Binding languages.LanguageSetTitle}" Style="{StaticResource SubtitleText}" Margin="0,0,0,20"/>
                        <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding LangList}" DisplayMemberPath="LangName" SelectedValue="{Binding SwitchLang, Mode=OneWayToSource}" SelectedValuePath="LangFileName" SelectedIndex="{Binding LangIndex, Mode=OneWay}" Margin="0,0,0,20"/>
                        <Button Content="{Binding languages.SaveAndRestartBtn}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveLangCommand}" HorizontalAlignment="Left" Padding="24,0" Height="36"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 5: Function Settings -->
                <TabItem>
                    <TabItem.Template><ControlTemplate TargetType="TabItem"><ContentPresenter/></ControlTemplate></TabItem.Template>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
                        <StackPanel MaxWidth="600">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="{Binding languages.NavBarFunctionsHeader}"/>
                            <TextBlock Text="{Binding languages.NavBarFunctionsDesc}" Foreground="#80FFFFFF" FontSize="12" Margin="0,0,0,16"/>
                            <CheckBox Content="{Binding languages.NavScreenshotsCkb}" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NavScreenshots}" Margin="0,0,0,12"/>
                            <CheckBox Content="{Binding languages.NavQQGroupCkb}" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NavQQGroup}" Margin="0,0,0,12"/>
                            <CheckBox Content="{Binding languages.NavAboutCkb}" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NavAbout}" Margin="0,0,0,12"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 6: Program Settings -->
                <TabItem>
                    <TabItem.Template><ControlTemplate TargetType="TabItem"><ContentPresenter/></ControlTemplate></TabItem.Template>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
                        <StackPanel MaxWidth="600">
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="{Binding languages.ProgramSettingsHeader}"/>
                            <CheckBox Content="{Binding languages.StartedCloseCkb}" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsRunThenClose}" Margin="0,0,0,12"/>
                            <CheckBox Content="{Binding languages.NoCheckUpdateCkb}" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsCloseUpdate}" Margin="0,0,0,20"/>
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="{Binding languages.QuickActionsHeader}"/>
                            <WrapPanel>
                                <Button Content="{Binding languages.CheckUpdateBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding CheckUpdateCommand}" Margin="0,0,8,8"/>
                                <Button Content="{Binding languages.OpenProgameFolderBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding OpenApplicationFolderCommand}" Margin="0,0,8,8"/>
                                <Button Content="{Binding languages.RecoverDefaultSizeBtn}" Style="{StaticResource SecondaryButton}" Command="{Binding RecoverDefaultSizeCommand}" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>