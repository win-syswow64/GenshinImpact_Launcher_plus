<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>2.0.0.0</Version>
    <StartupObject>GenShin_Launcher_Plus.App</StartupObject>
    <ApplicationIcon>ICON.ico</ApplicationIcon>
    <IsPublishable>True</IsPublishable>
    <Platforms>AnyCPU;x64</Platforms>
    <DebugType>embedded</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Authors>DawnFz &amp; Catboss</Authors>
    <Product>原神启动器Plus</Product>
    <!-- Keep verification/build output inside this project from being globbed as source. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\AboutButton.png" />
    <None Remove="Images\AddUserButton.png" />
    <None Remove="Images\ImagesButton.png" />
    <None Remove="Images\MainBackground.jpg" />
    <None Remove="Images\SettingsButton.png" />
    <None Remove="Images\TencentGroupButton.png" />
    <None Remove="Images\UI_0.jpg" />
    <None Remove="StaticRes\Update.dll" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="ICON.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\UI_0.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.0.0-preview3" />
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\AboutButton.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\MainBackground.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\ImagesButton.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\TencentGroupButton.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\SettingsButton.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\genshin_icon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\starrail_icon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\zzz_icon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\honkai3_icon.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\AddUserButton.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="StaticRes\Update.dll">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Update="App.xaml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </ApplicationDefinition>
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Themes\WinUI3Theme.xaml" />
    <Resource Include="Themes\WinUI3Theme.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lang\zh-CN.json" />
    <EmbeddedResource Include="Lang\zh-TW.json" />
    <EmbeddedResource Include="Lang\en.json" />
    <EmbeddedResource Include="Lang\ja.json" />
  </ItemGroup>
</Project>
