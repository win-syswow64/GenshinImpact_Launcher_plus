<Window x:Class="GenShin_Launcher_Plus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        MouseLeftButtonDown="WindowDragMove"
        d:Height="730" d:Width="1280"
        MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="原神启动器Plus">
    <Border CornerRadius="8" ClipToBounds="True" Background="#202020">
        <Grid x:Name="MainGrid">
            <Grid.Background>
                <ImageBrush x:Name="BackgroundImage" Stretch="UniformToFill"
                            ImageSource="/Images/MainBackground.jpg"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Top Game Selector Bar -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Height="52"
                    Background="#CC1A1A1A" BorderBrush="#20FFFFFF"
                    BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Game Icons -->
                    <ListBox Grid.Column="0" ItemsSource="{Binding GameList}"
                             SelectedIndex="{Binding SelectedGameIndex}"
                             BorderThickness="0" Background="Transparent"
                             Padding="0" VerticalAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" BorderThickness="2"
                                                    BorderBrush="Transparent" CornerRadius="8"
                                                    Background="Transparent" SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#40FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="36" Height="36" ToolTip="{Binding DisplayName}">
                                    <Border CornerRadius="8" Background="{Binding IconColor}"/>
                                    <TextBlock Text="{Binding IconText}" FontSize="16" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Server Selector -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding languages.GameClientStr}"
                                   Foreground="#80FFFFFF" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding ServerDisplayNames}"
                                  SelectedIndex="{Binding SelectedServerIndex}"
                                  Style="{StaticResource DarkComboBox}"
                                  MinWidth="90" Height="30" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Left Sidebar -->
            <Border x:Name="Sidebar" Grid.Row="1" Grid.Column="0" Width="48"
                    Background="#B31E1E1E" BorderBrush="#20FFFFFF"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" x:Name="ToggleBtn"
                            Style="{StaticResource IconButton}" Width="36" Height="36"
                            Margin="6,12,0,0" HorizontalAlignment="Left"
                            Foreground="#B0FFFFFF" Click="ToggleSidebar"
                            Content="&#xE700;"/>

                    <!-- Collapsed (icons only) -->
                    <StackPanel x:Name="CollapsedPanel" Grid.Row="1" Margin="6,8,6,0">
                        <Button Style="{StaticResource IconButton}" Foreground="#B0FFFFFF"
                                Command="{Binding OpenImagesDirectoryCommand}" ToolTip="{Binding languages.NavScreenshotsToolTip}" Visibility="{Binding NavScreenshotsVisible}"
                                Content="&#xE8B9;"/>
                        <Button Style="{StaticResource IconButton}" Foreground="#B0FFFFFF"
                                Command="{Binding OpenQQGroupUrlCommand}" ToolTip="{Binding languages.NavQQGroupText}" Visibility="{Binding NavQQGroupVisible}"
                                Content="&#xE8B8;"/>
                        <Button Style="{StaticResource IconButton}" Foreground="#B0FFFFFF"
                                Command="{Binding OpenAboutCommand}" ToolTip="{Binding languages.NavAboutText}" Visibility="{Binding NavAboutVisible}"
                                Content="&#xE946;"/>
                        <Button Style="{StaticResource IconButton}" Foreground="#B0FFFFFF"
                                Command="{Binding NavigateProgramSettingsCommand}" ToolTip="{Binding languages.NavSettingsText}"
                                Content="&#xE713;"/>
                    </StackPanel>

                    <!-- Expanded (icon + text) -->
                    <StackPanel x:Name="ExpandedPanel" Grid.Row="1" Margin="8,8,8,0" Visibility="Collapsed">
                        <RadioButton Style="{StaticResource NavButton}" IsChecked="True"
                                     Command="{Binding OpenImagesDirectoryCommand}" Margin="0,0,0,2" Visibility="{Binding NavScreenshotsVisible}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" Width="28" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding languages.NavScreenshotsText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}"
                                     Command="{Binding OpenQQGroupUrlCommand}" Margin="0,0,0,2" Visibility="{Binding NavQQGroupVisible}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" Width="28" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding languages.NavQQGroupText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}"
                                     Command="{Binding OpenAboutCommand}" Margin="0,0,0,2" Visibility="{Binding NavAboutVisible}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" Width="28" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding languages.NavAboutText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}"
                                     Command="{Binding NavigateProgramSettingsCommand}" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" Width="28" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding languages.NavSettingsText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom (collapsed) -->
                    <StackPanel x:Name="CollapsedBottom" Grid.Row="2" Margin="6,0,6,8">
                        <Button Style="{StaticResource IconButton}" Foreground="#B0FFFFFF"
                                Command="{Binding MainMinimizedCommand}" ToolTip="{Binding languages.MinimizeToolTip}"
                                Content="&#xE949;"/>
                        <Button Style="{StaticResource IconButton}" Foreground="#B0FFFFFF"
                                Command="{Binding ExitProgramCommand}" ToolTip="{Binding languages.CloseToolTip}"
                                Content="&#xE8BB;"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1" Grid.Column="1" x:Name="ContentArea" Background="Transparent" MouseLeftButtonDown="ContentArea_MouseLeftButtonDown">
                <Grid>
                    <!-- Overlay for secondary pages -->
                    <Border x:Name="PageOverlay" Background="#A0000000"
                            Visibility="{Binding OverlayVisible}"/>

                    <ContentControl x:Name="PageContent" Content="{Binding CurrentPage}"/>

                    <!-- Launch Panel: visible only when no page overlay -->
                    <StackPanel x:Name="LaunchPanel" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,32,32"
                                Visibility="{Binding LaunchPanelVisible}">
                        <Button Content="{Binding languages.RunGameBtn}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding RunGameCommand}" IsEnabled="{Binding CanRunGame}"
                                Height="52" Width="220"
                                FontSize="18" FontWeight="SemiBold"/>
                        <Button Style="{StaticResource SecondaryButton}" Height="52" Width="52"
                                FontSize="18" FontFamily="{StaticResource IconFont}"
                                Command="{Binding OpenGameSettingsCommand}"
                                Content="&#xE713;"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>