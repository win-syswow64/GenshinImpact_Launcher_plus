<Window x:Class="GenShin_Launcher_Plus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:Height="730" d:Width="1280"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource AppBackgroundBrush}"
        Icon="/ICON.ico"
        Title="{Binding Title}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootChrome" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource WindowStrokeBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="MainGrid">
            <!-- Immersive game background, managed by MainWindow.xaml.cs. -->
            <Image x:Name="BackgroundImage" Source="/Images/MainBackground.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            <MediaElement x:Name="BackgroundVideo" Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Stop" IsMuted="True" Opacity="0"
                          MediaOpened="MediaElement_Opened" MediaFailed="MediaElement_Failed" MediaEnded="MediaElement_Ended"/>
            <Image x:Name="VideoFrameImage" Stretch="UniformToFill" Opacity="0"/>
            <Image x:Name="VideoOverlayImage" Stretch="UniformToFill" Opacity="0"/>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E8101722" Offset="0"/>
                        <GradientStop Color="#B3101722" Offset="0.32"/>
                        <GradientStop Color="#280C111A" Offset="0.68"/>
                        <GradientStop Color="#780A0F17" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Compact navigation, based on Starward's left-compact navigation mode. -->
                <Border x:Name="Sidebar" Grid.Column="0" Background="#DC101721" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0">
                    <Border.Resources>
                        <Style x:Key="SidebarNavigationButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Width" Value="{Binding SidebarButtonWidth}"/>
                            <Setter Property="Height" Value="54"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="64"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                            <Button Width="54" Height="54" Command="{Binding ToggleSidebarCommand}" ToolTip="展开或收起导航" FontSize="25">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Content" Value="&#xE700;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                                <Setter Property="Content" Value="&#xE76B;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="8,4" VerticalAlignment="Top">
                            <Button Style="{StaticResource SidebarNavigationButton}" Margin="0,0,0,9" Command="{Binding NavigateHomeCommand}" ToolTip="主页">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="20" Width="38" VerticalAlignment="Center" TextAlignment="Center"/><TextBlock Text="主页" FontFamily="{StaticResource DefaultFont}" FontSize="13" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarNavigationButton}" Margin="0,0,0,9" Command="{Binding NavigateUsersCommand}" ToolTip="{Binding languages.AccountManageTab}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="20" Width="38" VerticalAlignment="Center" TextAlignment="Center"/><TextBlock Text="账号管理" FontFamily="{StaticResource DefaultFont}" FontSize="13" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarNavigationButton}" Margin="0,0,0,9" Command="{Binding OpenImagesDirectoryCommand}" ToolTip="{Binding languages.NavScreenshotsToolTip}" Visibility="{Binding NavScreenshotsVisible}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="20" Width="38" VerticalAlignment="Center" TextAlignment="Center"/><TextBlock Text="截图" FontFamily="{StaticResource DefaultFont}" FontSize="13" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarNavigationButton}" Margin="0,0,0,9" Command="{Binding OpenQQGroupUrlCommand}" ToolTip="{Binding languages.NavQQGroupText}" Visibility="{Binding NavQQGroupVisible}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B8;" FontFamily="{StaticResource IconFont}" FontSize="20" Width="38" VerticalAlignment="Center" TextAlignment="Center"/><TextBlock Text="社区" FontFamily="{StaticResource DefaultFont}" FontSize="13" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarNavigationButton}" Command="{Binding OpenAboutCommand}" ToolTip="{Binding languages.NavAboutText}" Visibility="{Binding NavAboutVisible}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="20" Width="38" VerticalAlignment="Center" TextAlignment="Center"/><TextBlock Text="关于" FontFamily="{StaticResource DefaultFont}" FontSize="13" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Row="2" Style="{StaticResource IconButton}" Width="{Binding SidebarButtonWidth}" Height="54" HorizontalAlignment="Left" Margin="8,0" VerticalAlignment="Center"
                                Command="{Binding NavigateProgramSettingsCommand}" ToolTip="{Binding languages.NavSettingsText}" Content="&#xE713;" FontSize="20"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Game selector and window controls. -->
                    <Border Grid.Row="0" Background="#160B111A" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                        <Grid Margin="18,10,18,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                <Border Width="42" Height="42" Background="#30FFFFFF" CornerRadius="10">
                                    <Image Source="/ICON.ico" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ProgramVersionText}" Foreground="#9DFFFFFF" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <ListBox Grid.Column="1" ItemsSource="{Binding GameList}" SelectedIndex="{Binding SelectedGameIndex}" Background="Transparent" BorderThickness="0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="GameTab" Width="48" Height="48" Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GameTab" Property="Background" Value="#31FFFFFF"/></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="GameTab" Property="Background" Value="#42FFFFFF"/><Setter TargetName="GameTab" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Image Width="36" Height="36" Source="{Binding IconPath}" Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsInstalled}" Value="False"><Setter Property="Opacity" Value="0.42"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding ServerDisplayNames}" SelectedIndex="{Binding SelectedServerIndex}" Style="{StaticResource DarkComboBox}" Foreground="White" MinWidth="104" Height="32" FontSize="12" Margin="0,0,12,0"/>
                                <Button Style="{StaticResource IconButton}" Width="34" Height="34" Command="{Binding MainMinimizedCommand}" ToolTip="{Binding languages.MinimizeToolTip}" Content="&#xE949;"/>
                                <Button Style="{StaticResource IconButton}" Width="34" Height="34" Command="{Binding ExitProgramCommand}" ToolTip="{Binding languages.CloseToolTip}" Content="&#xE8BB;"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Border x:Name="PageOverlay" Background="#A60C121C" Visibility="{Binding OverlayVisible}"/>
                        <ContentControl x:Name="PageContent" Content="{Binding CurrentPage}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
