<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Starward-inspired lightweight WinUI palette ===== -->
    <Color x:Key="AccentColor">#9EA9CC</Color>
    <Color x:Key="AccentLightColor">#C1C9E5</Color>
    <Color x:Key="AccentDarkColor">#7883A8</Color>

    <!-- Background layers -->
    <Color x:Key="LayerFillColorDefault">#17181C</Color>
    <Color x:Key="LayerFillColorAlt">#202126</Color>
    <Color x:Key="LayerFillColorCard">#26282E</Color>
    <Color x:Key="LayerFillColorCardHover">#30333A</Color>
    <Color x:Key="LayerFillColorCardPressed">#363941</Color>

    <!-- Control fills -->
    <Color x:Key="ControlFillColorDefault">#30323A</Color>
    <Color x:Key="ControlFillColorSecondary">#3A3D46</Color>
    <Color x:Key="ControlFillColorDisabled">#262830</Color>
    <Color x:Key="ControlFillColorInputText">#24262D</Color>

    <!-- Strokes -->
    <Color x:Key="ControlStrokeColorDefault">#4B4F5A</Color>
    <Color x:Key="ControlStrokeColorSecondary">#606572</Color>
    <Color x:Key="ControlStrokeColorDivider">#343742</Color>

    <!-- Text -->
    <Color x:Key="TextFillColorPrimary">#FFFFFF</Color>
    <Color x:Key="TextFillColorSecondary">#B0B0B0</Color>
    <Color x:Key="TextFillColorTertiary">#808080</Color>
    <Color x:Key="TextFillColorDisabled">#4D4D4D</Color>
    <Color x:Key="TextOnAccentFillColorPrimary">#FFFFFF</Color>
    <Color x:Key="TextOnAccentFillColorSecondary">#DDFFFFFF</Color>

    <!-- Subtle fills -->
    <Color x:Key="SubtleFillColorTransparent">#00FFFFFF</Color>
    <Color x:Key="SubtleFillColorHover">#12FFFFFF</Color>
    <Color x:Key="SubtleFillColorPressed">#08FFFFFF</Color>

    <!-- System colors -->
    <Color x:Key="SystemFillColorCritical">#FF6B6B</Color>
    <Color x:Key="SystemFillColorSuccess">#6BCB77</Color>
    <Color x:Key="SystemFillColorWarning">#FFD93D</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{DynamicResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{DynamicResource AccentDarkColor}"/>

    <SolidColorBrush x:Key="LayerFillBrush" Color="{StaticResource LayerFillColorDefault}"/>
    <SolidColorBrush x:Key="LayerFillAltBrush" Color="{StaticResource LayerFillColorAlt}"/>
    <SolidColorBrush x:Key="LayerFillCardBrush" Color="{StaticResource LayerFillColorCard}"/>
    <SolidColorBrush x:Key="LayerFillCardHoverBrush" Color="{StaticResource LayerFillColorCardHover}"/>
    <SolidColorBrush x:Key="LayerFillCardPressedBrush" Color="{StaticResource LayerFillColorCardPressed}"/>

    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColorDefault}"/>
    <SolidColorBrush x:Key="ControlFillSecondaryBrush" Color="{StaticResource ControlFillColorSecondary}"/>
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="{StaticResource ControlFillColorDisabled}"/>
    <SolidColorBrush x:Key="ControlFillInputBrush" Color="{StaticResource ControlFillColorInputText}"/>

    <SolidColorBrush x:Key="ControlStrokeBrush" Color="{StaticResource ControlStrokeColorDefault}"/>
    <SolidColorBrush x:Key="ControlStrokeSecondaryBrush" Color="{StaticResource ControlStrokeColorSecondary}"/>
    <SolidColorBrush x:Key="ControlStrokeDividerBrush" Color="{StaticResource ControlStrokeColorDivider}"/>

    <SolidColorBrush x:Key="TextFillBrush" Color="{StaticResource TextFillColorPrimary}"/>
    <SolidColorBrush x:Key="TextFillSecondaryBrush" Color="{StaticResource TextFillColorSecondary}"/>
    <SolidColorBrush x:Key="TextFillTertiaryBrush" Color="{StaticResource TextFillColorTertiary}"/>
    <SolidColorBrush x:Key="TextFillDisabledBrush" Color="{StaticResource TextFillColorDisabled}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentFillColorPrimary}"/>

    <SolidColorBrush x:Key="SubtleFillBrush" Color="{StaticResource SubtleFillColorTransparent}"/>
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="{StaticResource SubtleFillColorHover}"/>
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="{StaticResource SubtleFillColorPressed}"/>

    <SolidColorBrush x:Key="SystemFillCriticalBrush" Color="{StaticResource SystemFillColorCritical}"/>
    <SolidColorBrush x:Key="SystemFillSuccessBrush" Color="{StaticResource SystemFillColorSuccess}"/>
    <SolidColorBrush x:Key="SystemFillWarningBrush" Color="{StaticResource SystemFillColorWarning}"/>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111216"/>
    <SolidColorBrush x:Key="WindowStrokeBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="TopBarBrush" Color="#CC17181C"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#B817181C"/>
    <SolidColorBrush x:Key="GlassPanelBrush" Color="#D91D1F26"/>
    <SolidColorBrush x:Key="GlassPanelHoverBrush" Color="#E6262931"/>
    <SolidColorBrush x:Key="PanelStrokeBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="BackgroundScrimBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="PageOverlayBrush" Color="#D9111216"/>
    <SolidColorBrush x:Key="MutedWhiteBrush" Color="#99FFFFFF"/>

    <!-- ===== Fonts ===== -->
    <FontFamily x:Key="DefaultFont">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="TitleFont">Segoe UI Light, Microsoft YaHei UI Light</FontFamily>

    <!-- ===== CornerRadius ===== -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="CircleCornerRadius">999</CornerRadius>

    <!-- ===== Button Styles ===== -->
    <!-- Primary Button -->
    <!-- Default implicit Button style (catches unstyled buttons) -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8,16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleFillHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleFillPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ControlFillDisabledBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFillDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8,16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ControlFillDisabledBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFillDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8,16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ControlFillSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ControlFillDisabledBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ControlFillDisabledBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFillDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon Button -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="False"
                                          SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleFillHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleFillPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nav Button -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,10,12,10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="NavBar"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="indicator"
                                    Width="3" Height="0"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="-12,0,9,0"/>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleFillHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleFillHoverBrush}"/>
                            <Setter TargetName="indicator" Property="Height" Value="16"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TextBox ===== -->
    <Style x:Key="InputTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ControlFillInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,4,10,4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextFillBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,2"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ControlStrokeSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ControlFillDisabledBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFillDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox ===== -->
    <!-- ComboBox -->
    <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
    </Style>

    <!-- Implicit default ComboBoxItem style for dark theme -->
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}"/>


    <Style x:Key="DarkComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6,28,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="toggleButton"
                                      Grid.ColumnSpan="2"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="toggleBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource ControlCornerRadius}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter x:Name="contentPresenter"
                                                              Grid.Column="0"
                                                              Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              IsHitTestVisible="False"/>
                                            <TextBlock Grid.Column="1"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextFillSecondaryBrush}"
                                                       Text="&#xE70D;"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"
                                                       IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="toggleBorder" Property="Background" Value="{StaticResource ControlFillDisabledBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PopupAnimation="Slide"
                               Focusable="False">
                            <Border x:Name="dropDown"
                                    Background="{StaticResource ControlFillBrush}"
                                    BorderBrush="{StaticResource ControlStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer Padding="2">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource ControlFillDisabledBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFillDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ToggleSwitch (CheckBox) ===== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="trackBorder"
                                    Width="40" Height="20"
                                    CornerRadius="10"
                                    Background="#484848"
                                    BorderBrush="#555555"
                                    BorderThickness="1">
                                <Ellipse x:Name="thumb"
                                         Width="12" Height="12"
                                         Fill="#CCCCCC"
                                         HorizontalAlignment="Left"
                                         Margin="4,0,0,0"/>
                            </Border>
                        </StackPanel>
                        <ContentPresenter Grid.Column="1"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="trackBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="trackBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="thumb" Property="Fill" Value="White"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="trackBorder" Property="Background" Value="{StaticResource ControlFillDisabledBrush}"/>
                            <Setter TargetName="thumb" Property="Fill" Value="{StaticResource TextFillDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ProgressBar ===== -->
    <Style x:Key="AccentProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Height="{TemplateBinding Height}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ListBox ===== -->
    <Style x:Key="DarkListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource ControlFillInputBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
    </Style>

    <Style x:Key="DarkListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleFillHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleFillHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBar ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#484848"
                                                    CornerRadius="4"
                                                    Margin="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Card Style ===== -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LayerFillCardBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Shared secondary-page language: a restrained dark glass surface with a clear hierarchy. -->
    <Style x:Key="SubPageSurface" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="#B818222F"/>
        <Setter Property="BorderBrush" Value="#36FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="28"/>
    </Style>

    <Style x:Key="SubPageHeader" TargetType="Border">
        <Setter Property="Background" Value="#82101824"/>
        <Setter Property="BorderBrush" Value="#2FFFFFFF"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="24,14"/>
    </Style>

    <Style x:Key="SettingsSectionCard" TargetType="Border">
        <Setter Property="Background" Value="#401A2430"/>
        <Setter Property="BorderBrush" Value="#2BFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- ===== TextBlock Styles ===== -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillSecondaryBrush}"/>
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ===== GroupBox ===== -->
    <Style x:Key="DarkGroupBox" TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource LayerFillCardBrush}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CardCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="12,10,12,6">
                                <ContentPresenter ContentSource="Header"
                                                  TextBlock.FontWeight="SemiBold"
                                                  TextBlock.FontSize="13"
                                                  TextBlock.Foreground="{StaticResource TextFillSecondaryBrush}"/>
                            </Border>
                            <Border Grid.Row="1" Padding="12,0,12,12">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Collapsed Nav Button (icon only) -->
    <Style x:Key="NavButtonCollapsed" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextFillSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="NavBar"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Width="36" Height="36"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="indicator"
                                    Width="3" Height="0"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="-18,0,0,0"/>
                            <TextBlock Text="{TemplateBinding Tag}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleFillHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                            <Setter TargetName="indicator" Property="Height" Value="16"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFillBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style></ResourceDictionary>
